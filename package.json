{
  "name": "inkchime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "build": "tsc -p . --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "playtest": "node tests/playtest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.52.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "wrangler": "4.160.0"
  }
}
