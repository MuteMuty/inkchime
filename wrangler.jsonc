{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkchime",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "inkchime.brightloopapps.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
